## Example environment variables
# Copy to .env or set in your CI / Expo config

EXPO_PUBLIC_GROQ_API_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Supabase (sync layer — non-critical path)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key



# Analytics (optional)
EXPO_PUBLIC_POSTHOG_KEY=your-posthog-key

# Feature flags
EXPO_PUBLIC_AI_EXPLANATIONS_ENABLED=false
EXPO_PUBLIC_REALTIME_SYNC_ENABLED=false

# Rule signature verification
EXPO_PUBLIC_RULES_SIGNATURE_SECRET=change-me
